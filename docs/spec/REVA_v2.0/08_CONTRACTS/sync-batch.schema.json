{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reva.local/schemas/sync-batch/2.0",
  "title": "REVA sync batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batch_id",
    "from_device_id",
    "to_device_id",
    "domain",
    "cursor_from",
    "transport"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "batch_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 64
    },
    "from_device_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 64
    },
    "to_device_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 64
    },
    "domain": {
      "enum": [
        "memory",
        "finance",
        "health",
        "coach",
        "career",
        "learn",
        "cyber",
        "personal"
      ]
    },
    "cursor_from": {
      "type": "integer",
      "minimum": 0
    },
    "transport": {
      "enum": [
        "lan",
        "relay"
      ]
    },
    "events": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "https://reva.local/schemas/domain-event/1.0"
      }
    },
    "relay_envelope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "group_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 64
        },
        "seq": {
          "type": "integer"
        },
        "nonce": {
          "type": "string"
        },
        "ciphertext": {
          "type": "string"
        }
      },
      "required": [
        "group_id",
        "seq",
        "nonce",
        "ciphertext"
      ]
    }
  },
  "oneOf": [
    {
      "properties": {
        "transport": {
          "const": "lan"
        }
      },
      "required": [
        "events"
      ]
    },
    {
      "properties": {
        "transport": {
          "const": "relay"
        }
      },
      "required": [
        "relay_envelope"
      ],
      "not": {
        "required": [
          "events"
        ]
      }
    }
  ]
}
