<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Exactly two permissions, both for pairing and syncing with the user's OWN PC (SYNC-1d):
        - INTERNET: HTTPS to the PC's pairing gateway on the local network. The gateway's TLS key is pinned
          from the QR code, cleartext is refused (network_security_config), and no server of ours is involved.
        - CAMERA: only to read the pairing QR code on the PC; asked for when the user taps "Scan the code".
          The camera is optional hardware, so phones without one can still paste the code.
        ACCESS_NETWORK_STATE is not needed (plain sockets), and the "local network" permission Android
        introduces for apps targeting API 37+ does not apply at targetSdk 36. src/test checks this exact set
        on every build, and that there is no QUERY_ALL_PACKAGES and no AccessibilityService.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".RevaApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Reva">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Share sheet for Export: hands out one cached file through a content:// URI, nothing else. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.exports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/export_paths" />
        </provider>
    </application>
</manifest>
