<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup and device-transfer rules. REVA's domain files and their wrapped keys live in
     noBackupFilesDir ("no_backup" under the root domain) and must never leave the phone this way. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="no_backup" />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="no_backup" />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
