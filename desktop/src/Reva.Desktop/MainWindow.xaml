<Window
    x:Class="Reva.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:state="using:Reva.Desktop.State"
    xmlns:views="using:Reva.Desktop.Views">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid ColumnDefinitions="232,*" Background="{StaticResource RevaGroundBrush}">

    <views:NavPane x:Name="Nav" Grid.Column="0" />

    <Grid Grid.Column="1">

    <!-- Talk & Today: the existing assistant/voice/memory UI, unchanged, under the Today summary. -->
    <Grid x:Name="TalkPage" RowDefinitions="Auto,*" Visibility="{x:Bind views:Vis.Show(Navigation.ShowsTalk), Mode=OneWay}">
    <views:TodayCard x:Name="TodayPanel" Margin="24,24,24,0" ViewModel="{x:Bind Today}" />

    <Grid Grid.Row="1" Padding="24" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,Auto" Loaded="Root_Loaded">

        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Text="REVA" FontSize="28" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Ellipse x:Name="StatusDot" Width="10" Height="10" />
                <TextBlock
                    AutomationProperties.AutomationId="CoreStatusText"
                    Text="{x:Bind Shell.CoreStatusText, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>

        <!--
            No {StaticResource}-based IValueConverter anywhere on this page:
            combining an x:Bind Converter with a Window root (rather than a
            Page/UserControl) triggers a WinUI 3 XAML-compiler codegen bug
            (SetConverterLookupRoot expects a FrameworkElement, Window isn't
            one — CS1503 at build time). Status dot color is set imperatively
            in code-behind; message role labels and the pending flag are
            plain string/bool properties on the ViewModels instead.
        -->

        <TextBlock Grid.Row="1" Margin="0,16,0,8" Text="Assistant" FontSize="16" FontWeight="SemiBold" />

        <ListView
            Grid.Row="2" x:Name="MessageList"
            AutomationProperties.AutomationId="MessageList"
            ItemsSource="{x:Bind Assistant.Messages}" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="state:AssistantMessage">
                    <StackPanel Orientation="Horizontal" Spacing="8" Padding="0,4">
                        <TextBlock Text="{x:Bind RoleLabel}" FontWeight="SemiBold" Width="64" />
                        <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            Grid.Row="3" Margin="0,4,0,4"
            AutomationProperties.AutomationId="ErrorMessageText"
            Text="{x:Bind Assistant.ErrorMessage, Mode=OneWay}"
            Foreground="IndianRed" TextWrapping="Wrap" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8">
            <TextBox
                x:Name="ComposerBox"
                AutomationProperties.AutomationId="ComposerBox"
                Width="480"
                PlaceholderText="Type a message..."
                Text="{x:Bind Assistant.ComposerText, Mode=TwoWay}"
                IsEnabled="{x:Bind Assistant.IsNotPending, Mode=OneWay}"
                KeyDown="ComposerBox_KeyDown" />
            <Button
                x:Name="SendButton"
                AutomationProperties.AutomationId="SendButton"
                Content="Send"
                Click="SendButton_Click"
                IsEnabled="{x:Bind Assistant.IsNotPending, Mode=OneWay}" />
        </StackPanel>

        <StackPanel Grid.Row="5" Margin="0,12,0,0" Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button
                    x:Name="VoiceButton"
                    AutomationProperties.AutomationId="VoiceButton"
                    Content="Hold to Talk"
                    IsEnabled="{x:Bind Assistant.CanUseVoiceButton, Mode=OneWay}" />
                <!-- Hidden for the transcription-only voice slice: TTS playback is never
                     invoked from the voice path, so CanStopSpeaking is permanently false.
                     See .superpowers/sdd/2026-08-16-transcription-only-voice-slice/. Bindings
                     and ViewModel members are intentionally kept so this can be revived when
                     TTS returns as its own slice. -->
                <Button
                    x:Name="StopSpeakingButton"
                    AutomationProperties.AutomationId="StopSpeakingButton"
                    Content="Stop Speaking"
                    Click="StopSpeakingButton_Click"
                    IsEnabled="{x:Bind Assistant.CanStopSpeaking, Mode=OneWay}"
                    Visibility="Collapsed" />
                <TextBlock
                    AutomationProperties.AutomationId="VoiceStatusText"
                    Text="{x:Bind Assistant.VoiceStatusText, Mode=OneWay}"
                    VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock
                AutomationProperties.AutomationId="VoiceErrorText"
                Text="{x:Bind Assistant.VoiceErrorMessage, Mode=OneWay}"
                Foreground="IndianRed"
                TextWrapping="Wrap" />
            <Button
                x:Name="MicrophoneSettingsButton"
                AutomationProperties.AutomationId="MicrophoneSettingsButton"
                Content="Microphone Settings"
                Click="MicrophoneSettingsButton_Click" />
        </StackPanel>

        <!--
            Explicit memory: the ONLY UI path that creates durable memory
            (ADR-006). Deliberately separate from the assistant composer
            above - never wired to SendMessageAsync or triggered by chat.
        -->
        <TextBlock Grid.Row="6" Margin="0,16,0,8" Text="Memory" FontSize="16" FontWeight="SemiBold" />

        <StackPanel Grid.Row="7" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox
                    x:Name="MemoryBox"
                    AutomationProperties.AutomationId="MemoryBox"
                    Width="480"
                    PlaceholderText="Text to remember..."
                    Text="{x:Bind Memory.MemoryText, Mode=TwoWay}"
                    IsEnabled="{x:Bind Memory.IsNotPending, Mode=OneWay}" />
                <Button
                    x:Name="RememberButton"
                    AutomationProperties.AutomationId="RememberButton"
                    Content="Remember"
                    Click="RememberButton_Click"
                    IsEnabled="{x:Bind Memory.IsNotPending, Mode=OneWay}" />
                <Button
                    x:Name="SearchButton"
                    AutomationProperties.AutomationId="SearchButton"
                    Content="Search"
                    Click="SearchButton_Click"
                    IsEnabled="{x:Bind Memory.IsNotPending, Mode=OneWay}" />
            </StackPanel>
            <TextBlock
                AutomationProperties.AutomationId="MemoryStatusText"
                Text="{x:Bind Memory.StatusMessage, Mode=OneWay}"
                TextWrapping="Wrap" />
            <TextBlock
                AutomationProperties.AutomationId="MemorySearchResultText"
                Text="{x:Bind Memory.SearchResultText, Mode=OneWay}"
                TextWrapping="Wrap" />
        </StackPanel>

    </Grid>
    </Grid>

    <views:FinancePage
        x:Name="FinancePanel"
        ViewModel="{x:Bind Finance}"
        Visibility="{x:Bind views:Vis.Show(Navigation.ShowsFinance), Mode=OneWay}" />

    <views:DevicesPage
        x:Name="DevicesPanel"
        ViewModel="{x:Bind Devices}"
        Visibility="{x:Bind views:Vis.Show(Navigation.ShowsDevices), Mode=OneWay}" />

    <views:ComingSoonPage
        x:Name="ComingSoonPanel"
        Visibility="{x:Bind views:Vis.Show(Navigation.ShowsComingSoon), Mode=OneWay}" />

    </Grid>
    </Grid>

</Window>
