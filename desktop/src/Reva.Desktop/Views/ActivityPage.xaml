<UserControl
    x:Class="Reva.Desktop.Views.ActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Reva.Desktop.Views"
    xmlns:vm="using:Reva.Desktop.ViewModels">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <StackPanel Padding="24" Spacing="16" MaxWidth="1000" HorizontalAlignment="Left">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Activity" Style="{StaticResource RevaTitleText}" />
                <Button
                    Grid.Column="1"
                    Content="Refresh"
                    AutomationProperties.AutomationId="ActivityRefresh"
                    Click="Refresh_Click" />
            </Grid>
            <TextBlock
                Style="{StaticResource RevaMutedText}"
                TextWrapping="Wrap"
                Text="Everything REVA was asked to do, what happened, and what proves it. Amounts and notes are never kept here." />

            <Border
                Visibility="{x:Bind local:Vis.ShowText(ViewModel.Error), Mode=OneWay}"
                Style="{StaticResource RevaSmallCard}"
                BorderBrush="{StaticResource RevaErrorBrush}"
                AutomationProperties.LiveSetting="Assertive">
                <TextBlock Text="{x:Bind ViewModel.Error, Mode=OneWay}" Foreground="{StaticResource RevaErrorBrush}" TextWrapping="Wrap" />
            </Border>
            <TextBlock
                Style="{StaticResource RevaCaptionText}"
                Visibility="{x:Bind local:Vis.Show(ViewModel.IsEmpty), Mode=OneWay}"
                Text="Nothing yet. Ask REVA to open an app." />

            <ItemsControl ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}" AutomationProperties.AutomationId="ActivityList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ActivityEntry">
                        <Border Style="{StaticResource RevaSmallCard}" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="150,*,90,200" ColumnSpacing="14">
                                <TextBlock Text="{x:Bind Time}" Style="{StaticResource RevaCaptionText}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Bind Request}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Result}" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{x:Bind From}" Style="{StaticResource RevaCaptionText}" />
                                <TextBlock
                                    Grid.Column="3"
                                    Text="{x:Bind Evidence}"
                                    FontFamily="{StaticResource RevaMono}"
                                    Style="{StaticResource RevaCaptionText}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
