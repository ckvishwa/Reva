<UserControl
    x:Class="Reva.Desktop.Views.NavPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource RevaNavBrush}" BorderBrush="{StaticResource RevaBorderBrush}" BorderThickness="0,0,1,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel
                x:Name="Items"
                Padding="14,22"
                Spacing="4"
                AutomationProperties.AutomationId="NavPane"
                AutomationProperties.LandmarkType="Navigation"
                AutomationProperties.Name="Main"
                TabFocusNavigation="Once"
                XYFocusKeyboardNavigation="Enabled">
                <StackPanel Orientation="Horizontal" Spacing="10" Padding="10,4,10,18" AutomationProperties.AccessibilityView="Raw">
                    <Grid Width="26" Height="26">
                        <Ellipse Stroke="{StaticResource RevaAccentBrush}" StrokeThickness="2" Width="22" Height="22" />
                        <Ellipse Fill="{StaticResource RevaAccentBrush}" Width="8" Height="8" />
                    </Grid>
                    <TextBlock
                        Text="REVA"
                        FontFamily="{StaticResource RevaSansSemiBold}"
                        FontSize="17"
                        CharacterSpacing="80"
                        Foreground="{StaticResource RevaTextBrush}"
                        VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
