# REVA Core — example environment file. Copy to `.env` and edit.
# .env is git-ignored. Never commit real secrets.
#
# All values below are placeholders. REVA Phase 0 does not call any
# cloud provider; these exist to document the shape of future config.

# dev | prod
REVA_ENVIRONMENT=dev

# Loopback only. Non-loopback values are rejected at startup (security invariant #2).
REVA_API_HOST=127.0.0.1
REVA_API_PORT=8756

# Directory for SQLite DB + local state. Defaults to ./data in dev.
REVA_DATA_DIR=./data

# debug | info | warning | error
REVA_LOG_LEVEL=info

# Placeholder only — no real provider is implemented in Phase 0.
# Future: resolved via Windows Credential Manager / DPAPI, not plaintext env.
REVA_LLM_PROVIDER_API_KEY=
